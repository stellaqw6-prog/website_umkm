# === DATABASE ===
# Ambil connection string ini dari dashboard Neon (https://neon.tech) setelah membuat project.
# Formatnya kira-kira: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# === AUTH ===
# String rahasia untuk menandatangani session/JWT. Buat string acak panjang, jangan dibagikan.
# Bisa generate lewat terminal: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-yang-panjang-dan-rahasia"

# === APP ===
# URL publik website (dipakai untuk metadata SEO & link email). Saat development boleh dibiarkan seperti ini.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
