# === DATABASE ===
# Ambil connection string ini dari dashboard Neon (https://neon.tech) setelah membuat project.
# Formatnya kira-kira: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# === AUTH ===
# String rahasia untuk menandatangani session/JWT. Buat string acak panjang, jangan dibagikan.
# Bisa generate lewat terminal: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-yang-panjang-dan-rahasia"

# === APP ===
# URL publik website (dipakai untuk metadata SEO & link email). Saat development boleh dibiarkan seperti ini.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# === EMAIL (opsional, untuk fitur Lupa Password) ===
# Tanpa ini, link reset password tetap dibuat tapi hanya muncul di log server (terminal),
# tidak benar-benar terkirim ke email pelanggan. Untuk kirim email beneran:
# 1. Daftar gratis di https://resend.com
# 2. Verifikasi domain kamu (atau pakai domain testing bawaan Resend dulu)
# 3. Ambil API key dari dashboard, paste di bawah ini
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# === UPLOAD GAMBAR (untuk bukti transfer pembayaran) ===
# Daftar gratis di https://api.imgbb.com/ untuk dapat API key ini.
IMGBB_API_KEY=""
